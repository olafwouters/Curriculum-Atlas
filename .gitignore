# Credentials and local environment files
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Supabase CLI local state
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/.env.*

# Local runtime data (already tracked files are not untracked by these rules)
data/*.sqlite3
data/*.sqlite3-*
data/catalogue-cache/
data/deleted-workspaces/

# Python and editor artifacts
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
